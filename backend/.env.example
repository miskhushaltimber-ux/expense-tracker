PORT=3000
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Firestore is the app's database (there is no MongoDB, and no more
# Google Sheets as the database) ---
# Every user, login and expense record lives as a document in Firestore.
# You need GOOGLE_SERVICE_ACCOUNT_KEY (and usually FIRESTORE_DATABASE_ID) for
# the app to work at all — without them, the server starts but nothing can
# be saved.
#
# Setup (one-time, in Google Cloud Console — console.cloud.google.com),
# reusing the SAME project and service account Google Sheets already used:
#   1. Firestore Database (left sidebar) > Create database > Native mode >
#      pick a name (or leave it "(default)"). Note the name it shows at the
#      top of Firestore Studio afterwards — you need it in step 4.
#   2. IAM & Admin > IAM > find the existing service account (the same
#      xxx@xxx.iam.gserviceaccount.com used for Sheets) > pencil/edit icon >
#      Add another role > "Cloud Datastore User" > Save. (Sheets access was
#      granted by sharing a spreadsheet; Firestore access is granted here,
#      at the project level, instead.)
#   3. GOOGLE_SERVICE_ACCOUNT_KEY below is reused as-is — same JSON key,
#      no new key needed.
#   4. If the database name from step 1 is NOT "(default)", set
#      FIRESTORE_DATABASE_ID to it below (Rishi's is "expensetracker").
#
# The app creates every collection automatically on first write — there's no
# separate "create the tabs" step the way Sheets needed.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIRESTORE_DATABASE_ID=expensetracker

# --- One-time only: migrating existing data from the old Google Sheet ---
# If you already have real data sitting in the old Sheets database, set
# GOOGLE_SHEET_ID (its spreadsheet ID, same as before) and RUN_MIGRATION=true,
# then deploy once. On startup the server copies every row from that Sheet
# into Firestore (watch the deploy logs for "Sheets → Firestore migration
# finished"), then behaves normally. It's safe to leave RUN_MIGRATION=true by
# accident — a table already holding data in Firestore is skipped, so nothing
# is ever duplicated — but remove both variables once you've confirmed it ran,
# since they serve no purpose afterwards. Starting completely fresh with no
# old data to bring over? Skip this whole section.
GOOGLE_SHEET_ID=paste-the-old-spreadsheet-id-here
RUN_MIGRATION=true

# The "Export to Sheet" / "Import from Sheet" buttons in the Expense Sheet
# page are a SEPARATE, unrelated feature — they push a copy to, or pull rows
# from, any OTHER Google Sheet you paste a link for (for sharing a copy with
# someone, or bulk-importing an existing sheet). This still works exactly as
# before, reusing the same GOOGLE_SERVICE_ACCOUNT_KEY above; each target
# Sheet just needs to be shared with that same service account email as an
# Editor too. It does NOT need GOOGLE_SHEET_ID or FIRESTORE_DATABASE_ID.

# --- Sending email (password reset, and "Share Sheet > Email it") ---
#
# IMPORTANT: Render's free tier BLOCKS outbound SMTP ports (25, 465, 587) as
# of September 2025. Gmail SMTP cannot connect from the live server at all —
# it just hangs. So on Render you need BREVO_API_KEY, which sends over plain
# HTTPS instead. The Gmail app-password route below still works locally, and
# is used automatically when BREVO_API_KEY isn't set.
#
# Brevo setup (one-time, ~3 minutes, free, no card, 300 emails/day):
#   1. Sign up at brevo.com.
#   2. Senders, Domains & Dedicated IPs > Senders > Add a sender. Use the same
#      Gmail address you'll put in EMAIL_USER below. Brevo emails you a link —
#      click it to verify. No domain needed.
#   3. SMTP & API > API Keys > Generate a new API key. Copy it here.
# EMAIL_USER is still required: it's the verified "from" address.
BREVO_API_KEY=paste-your-brevo-api-key-here

# --- Gmail app password (local development only — blocked on Render free) ---
# Without these two set, the app still works fine — the "forgot password"
# form will just show "email isn't configured" instead of sending a link.
#
# Setup (one-time, takes ~2 minutes):
#   1. Turn on 2-Step Verification on the Gmail account you want to send
#      from (myaccount.google.com/security) — required before Google will
#      let you create an "app password".
#   2. Go to myaccount.google.com/apppasswords, sign in, create a new app
#      password (name it anything, e.g. "Expense Tracker App"). Google
#      shows you a 16-character password — copy it (no spaces needed).
#   3. Set EMAIL_USER to that Gmail address, and EMAIL_APP_PASSWORD to the
#      16-character app password (NOT your normal Gmail password — that
#      won't work here).
# These two ALSO power "Share Sheet > Email it" on the Expense Sheet page,
# which emails the whole sheet as a spreadsheet attachment to any address.
# Without them, both password reset and sheet-emailing are unavailable.
EMAIL_USER=youraccount@gmail.com
EMAIL_APP_PASSWORD=paste-the-16-character-app-password-here

# The reset link emailed to users points back at your live frontend, e.g.
# https://your-app.vercel.app (no trailing slash).
# Use http://localhost:5173 for local testing.
FRONTEND_URL=https://your-app.vercel.app

# --- Permanent storage for uploaded bills and vehicle documents (free) ---
# IMPORTANT: without these three, uploaded files fall back to the server's
# own disk — and on Render's free tier that disk is WIPED on every redeploy
# and every time the service spins down after inactivity. Files uploaded
# that way WILL eventually vanish. Set these to keep them permanently.
#
# (Google Drive can't be used for this, even though the app already has a
# Google service account: service accounts have zero Drive storage quota of
# their own, and uploading into a shared folder still bills the service
# account rather than the folder's owner. The official workarounds need paid
# Google Workspace.)
#
# Setup (one-time, ~2 minutes, no credit card):
#   1. Sign up free at cloudinary.com.
#   2. On the dashboard you land on, find "Product Environment Credentials"
#      — it shows Cloud Name, API Key and API Secret.
#   3. Copy those three values into the variables below.
#
# The free plan gives 25 monthly credits (1 credit = 1GB storage or 1GB of
# viewing bandwidth). Bills are a few hundred KB each, so this is years of
# headroom. The app uploads originals only — it never runs image
# transformations, which is the thing that normally burns through credits.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Daily backup (23 Sep) ---
# Any long random string. Put the SAME value in GitHub -> repo Settings ->
# Secrets and variables -> Actions as BACKUP_CRON_SECRET, plus BACKUP_URL =
# https://<your-render-app>.onrender.com/api/backup/scheduled
BACKUP_CRON_SECRET=make-up-a-long-random-string-here
